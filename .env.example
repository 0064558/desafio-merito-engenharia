# Valores locais de exemplo. Altere as senhas antes de usar.
POSTGRES_DB=posto_gasolina
POSTGRES_USER=merito_app
POSTGRES_PASSWORD=change-me-local-only

# Variáveis para executar a API pela IDE ou pelo Maven.
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5434/posto_gasolina
SPRING_DATASOURCE_USERNAME=merito_app
SPRING_DATASOURCE_PASSWORD=change-me-local-only

# Banco isolado para testes. O Compose inicia esse serviço apenas com o perfil "test".
POSTGRES_TEST_DB=posto_gasolina_test
POSTGRES_TEST_USER=merito_test
POSTGRES_TEST_PASSWORD=change-me-test-local-only
